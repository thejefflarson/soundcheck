{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/record-touched-path.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-review.py\"",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
