# Hermetic plugin manifest test.
#
# Builds a minimal node image, installs the same claude CLI version used
# by soundcheck-action, then runs `claude plugin validate` against both
# manifest files. Catches schema regressions like the v1.12.0 "agents:
# Invalid input" bug, where the `agents` field was set to a directory
# path instead of an array of files — `claude plugin validate` rejects
# this but only when pointed at plugin.json directly (the directory form
# picks marketplace.json instead).
#
# Local:
#     docker build -f Dockerfile.plugin-test .
# CI:
#     used by .github/workflows/static-checks.yml
FROM node:20.18.1-slim
# Postinstall must run so the platform-native binary is downloaded.
# This is a test-only image; we trust the package author.
# Supply-chain note: npm verifies the package tarball's sha512 via the
# registry; the postinstall step downloads a platform-native binary whose
# hash is not separately pinned (inherent to claude-code's packaging).
RUN npm install -g @anthropic-ai/claude-code@2.1.159
WORKDIR /plugin
# Drop to non-root before copying files and running validation (A02:2025).
RUN chown node:node /plugin
USER node
COPY --chown=node:node .claude-plugin /plugin/.claude-plugin
COPY --chown=node:node .claude /plugin/.claude
COPY --chown=node:node scripts/validate-hooks.py /plugin/scripts/validate-hooks.py
# Stage 1: manifest schema (`agents` field shape, etc.)
RUN claude plugin validate /plugin/.claude-plugin/plugin.json \
 && claude plugin validate /plugin/.claude-plugin/marketplace.json
# Stage 2: hook-substitution gate. Catches user_config refs that lack
# defaults — the v1.12.0/1/2 "autoReview isn't set" class of bug.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
USER node
RUN python3 /plugin/scripts/validate-hooks.py
